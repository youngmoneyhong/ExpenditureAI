OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini
# Number of screenshots read concurrently (1-4). Default: 3.
VISION_CONCURRENCY=3
SCREENSHOT_ARCHIVE_DIR=screenshots

# Google Drive/Sheets setup. Use the folder ID from:
# https://drive.google.com/drive/folders/{GOOGLE_DRIVE_FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
GOOGLE_WORKSHEET_NAME=Transactions
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional fallback for one fixed spreadsheet instead of year/month routing.
# GOOGLE_SHEET_ID=your-google-sheet-id
